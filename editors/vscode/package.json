{
  "name": "luna-language",
  "displayName": "Luna Language Support (Alpha)",
  "description": "Luna highlighting, formatting, saved-file diagnostics, symbols, and folding.",
  "version": "0.1.2",
  "private": true,
  "publisher": "luna-pl",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Luna-PL/toolchains.git",
    "directory": "editors/vscode"
  },
  "files": [
    "bin/**",
    "compatibility.json",
    "extension.js",
    "language-configuration.json",
    "syntaxes/**",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./extension.js",
  "scripts": {
    "check": "node --check extension.js && node scripts/validate-json.js",
    "stage:binaries": "node scripts/stage-binaries.js",
    "package:vsix": "vsce package"
  },
  "activationEvents": [
    "onLanguage:luna",
    "onCommand:luna.restartLanguageServer"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "luna",
        "aliases": [
          "Luna",
          "luna"
        ],
        "extensions": [
          ".luna"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "luna",
        "scopeName": "source.luna",
        "path": "./syntaxes/luna.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "luna.restartLanguageServer",
        "title": "Luna: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Luna",
      "properties": {
        "luna.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional path to luna-lsp. Empty uses the bundled binary, then PATH."
        },
        "luna.compiler.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional explicit path to the Luna compiler. Empty uses LUNA_BIN, PATH, then the development fallback."
        },
        "luna.formatter.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional path to luna-fmt. Empty uses the bundled binary, then PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
