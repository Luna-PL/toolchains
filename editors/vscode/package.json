{
  "name": "luna-language",
  "displayName": "Luna Language Support (Alpha)",
  "description": "Luna highlighting, formatting, saved-file diagnostics, symbols, and folding.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./extension.js",
  "scripts": {
    "check": "node --check extension.js && node scripts/validate-json.js"
  },
  "activationEvents": [
    "onLanguage:luna",
    "onCommand:luna.restartLanguageServer"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "luna",
        "aliases": ["Luna", "luna"],
        "extensions": [".luna"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "luna",
        "scopeName": "source.luna",
        "path": "./syntaxes/luna.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "luna.restartLanguageServer",
        "title": "Luna: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Luna",
      "properties": {
        "luna.server.path": {
          "type": "string",
          "default": "luna-lsp",
          "scope": "machine",
          "description": "Path to the luna-lsp executable."
        },
        "luna.compiler.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional explicit path to the Luna compiler. Empty uses LUNA_BIN, PATH, then the development fallback."
        },
        "luna.formatter.path": {
          "type": "string",
          "default": "luna-fmt",
          "scope": "machine",
          "description": "Path to the luna-fmt executable."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
